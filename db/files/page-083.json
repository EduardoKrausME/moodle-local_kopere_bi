          "html_before": "",
          "html_after": "",
          "commandsql": "SELECT fi.id,f.name AS feedback_name,f.course AS courseid,fi.name,\n COUNT(v.id) AS responses,COUNT(DISTINCT fc.id) AS respondents,\n SUM(CASE WHEN (fi.typ='numeric' OR (fi.typ='multichoicerated' AND fi.presentation NOT LIKE 'c>>>>>%'))\n AND v.value IS NOT NULL AND v.value<>'' AND v.value NOT LIKE '%|%' THEN 1 ELSE 0 END) AS numeric_responses,\n AVG(CASE WHEN (fi.typ='numeric' OR (fi.typ='multichoicerated' AND fi.presentation NOT LIKE 'c>>>>>%'))\n AND v.value IS NOT NULL AND v.value<>'' AND v.value NOT LIKE '%|%'\n THEN CAST(v.value AS DECIMAL(12,4)) END) AS avg_value\nFROM mdl_feedback f JOIN mdl_feedback_completed fc ON fc.feedback=f.id\n JOIN mdl_feedback_item fi ON fi.feedback=f.id\n JOIN mdl_feedback_value v ON v.completed=fc.id AND v.item=fi.id\nWHERE f.id>0 GROUP BY fi.id,fi.name,f.id,f.name,f.course",
          "cache": "1h",
