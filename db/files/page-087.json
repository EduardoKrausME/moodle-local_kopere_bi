          "css": "",
          "html_before": "",
          "html_after": "",
          "commandsql": "SELECT p.id,u.id AS userid,u.firstname,u.lastname,u.email,\n p.name AS plan_name,t.shortname AS template_name,p.status,p.timecreated,p.timemodified,\n COUNT(DISTINCT tc.competencyid) AS total_competencies,\n COUNT(DISTINCT CASE WHEN uc.proficiency=1 THEN tc.competencyid END) AS proficient_competencies,\n CASE WHEN COUNT(DISTINCT tc.competencyid)>0 THEN\n ROUND(100.0*COUNT(DISTINCT CASE WHEN uc.proficiency=1 THEN tc.competencyid END)/\n COUNT(DISTINCT tc.competencyid),2) ELSE 0 END AS progress_percent\nFROM mdl_competency_plan p JOIN mdl_user u ON u.id=p.userid\n JOIN mdl_competency_template t ON t.id=p.templateid\n LEFT JOIN mdl_competency_templatecomp tc ON tc.templateid=p.templateid\n LEFT JOIN mdl_competency_usercomp uc ON uc.userid=p.userid AND uc.competencyid=tc.competencyid\nWHERE p.templateid>0 AND u.deleted=0 AND u.suspended=0 AND u.username<>'guest'\nGROUP BY p.id,u.id,u.firstname,u.lastname,u.email,p.name,t.shortname,p.status,p.timecreated,p.timemodified\nORDER BY u.lastname,u.firstname,p.name",
          "cache": "1h",
          "reload": "none",
