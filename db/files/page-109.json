          "html_before": null,
          "html_after": null,
          "commandsql": "SELECT e.id, e.userid, u.firstname, u.lastname, u.email, e.courseid, c.fullname AS course, e.timeenrolled, e.dayssinceenrol, e.lastaccess, e.lastaction, e.daysinactive, e.actions7, e.actions14, e.actions30, e.timespent30, e.totalactivities, e.completedactivities, e.progress, e.gradepercent, e.timecompleted,\n       CASE e.engagement WHEN 'high' THEN 'lang::analytics_level_high::local_kopere_bi' WHEN 'medium' THEN 'lang::analytics_level_medium::local_kopere_bi' WHEN 'low' THEN 'lang::analytics_level_low::local_kopere_bi' ELSE 'lang::analytics_level_atrisk::local_kopere_bi' END AS engagement,\n       e.riskscore,\n       CASE e.risklevel WHEN 'high' THEN 'lang::analytics_level_high::local_kopere_bi' WHEN 'medium' THEN 'lang::analytics_level_medium::local_kopere_bi' WHEN 'low' THEN 'lang::analytics_level_low::local_kopere_bi' ELSE 'lang::analytics_level_none::local_kopere_bi' END AS risklevel\nFROM mdl_local_kopere_bi_engage e\nJOIN mdl_user u ON u.id = e.userid\nJOIN mdl_course c ON c.id = e.courseid\nWHERE e.batchid = (SELECT MAX(batchid) FROM mdl_local_kopere_bi_engage)\nORDER BY e.riskscore DESC, c.fullname, u.lastname, u.firstname",
