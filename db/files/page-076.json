          "block_num": 1,
          "type": "table",
          "theme": "light",
          "css": "",
          "html_before": "",
          "html_after": "",
          "commandsql": "SELECT MAX(kbi_fp.id) AS id, kbi_u.id AS userid,\n       kbi_c.fullname AS course, kbi_u.firstname, kbi_u.lastname, kbi_f.name,\n       COUNT(DISTINCT kbi_fp.id) AS posts,\n       COUNT(DISTINCT CASE WHEN kbi_fp.parent = 0 THEN kbi_fd.id END) AS discussions,\n       COUNT(DISTINCT CASE WHEN kbi_fp.parent = 0 THEN kbi_reply.id END) AS replies_received,\n       ROUND(1.0 * COUNT(DISTINCT CASE WHEN kbi_fp.parent = 0 THEN kbi_reply.id END) /\n             NULLIF(COUNT(DISTINCT CASE WHEN kbi_fp.parent = 0 THEN kbi_fd.id END), 0), 2) AS posts_per_discussion\nFROM mdl_forum_posts kbi_fp\nJOIN mdl_forum_discussions kbi_fd ON kbi_fd.id = kbi_fp.discussion\nJOIN mdl_forum kbi_f ON kbi_f.id = kbi_fd.forum\nJOIN mdl_course kbi_c ON kbi_c.id = kbi_f.course\nJOIN mdl_user kbi_u ON kbi_u.id = kbi_fp.userid\nLEFT JOIN mdl_forum_posts kbi_reply ON kbi_reply.discussion = kbi_fd.id AND kbi_reply.parent > 0\n     AND kbi_fd.userid = kbi_u.id AND kbi_fp.parent = 0\nWHERE kbi_c.id = :courseid AND kbi_u.deleted = 0 AND kbi_u.suspended = 0\n  AND kbi_u.username <> 'guest' AND kbi_c.visible = 1\nGROUP BY kbi_u.id, kbi_c.id, kbi_f.id\nORDER BY kbi_c.fullname, kbi_u.lastname, kbi_u.firstname, kbi_f.name",
          "cache": "1h",
          "reload": "none",
