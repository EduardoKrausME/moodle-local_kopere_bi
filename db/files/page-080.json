          "css": "",
          "html_before": "",
          "html_after": "",
          "commandsql": "SELECT CONCAT(a.id,'-',u.id) AS id, a.name AS assignment,a.duedate,co.fullname AS course,\n COALESCE(s.status,'new') AS status,s.timemodified AS submitted,\n CASE WHEN s.status='submitted' THEN 'late' ELSE 'pending' END AS overdue_status,\n CASE WHEN s.status='submitted' THEN FLOOR((s.timemodified-a.duedate)/86400)\n ELSE FLOOR((UNIX_TIMESTAMP()-a.duedate)/86400) END AS days_overdue,\n u.id AS userid,u.email,u.idnumber,u.phone1,u.phone2,u.institution,u.department,\n u.address,u.city,u.country,u.firstname,u.lastname,\n CASE WHEN gi.grademax>gi.grademin AND gg.finalgrade IS NOT NULL\n THEN ROUND(100.0*(gg.finalgrade-gi.grademin)/NULLIF(gi.grademax-gi.grademin,0),2) END AS grade\nFROM mdl_assign a\n JOIN mdl_course co ON co.id=a.course\n JOIN mdl_modules m ON m.name='assign'\n JOIN mdl_course_modules cm ON cm.course=co.id AND cm.instance=a.id AND cm.module=m.id\n JOIN (SELECT DISTINCT en.courseid,ue.userid FROM mdl_user_enrolments ue\n JOIN mdl_enrol en ON en.id=ue.enrolid WHERE en.status=0 AND ue.status=0\n AND (ue.timestart=0 OR ue.timestart<=UNIX_TIMESTAMP())\n AND (ue.timeend=0 OR ue.timeend>UNIX_TIMESTAMP())) enrolled ON enrolled.courseid=co.id\n JOIN mdl_user u ON u.id=enrolled.userid\n LEFT JOIN mdl_assign_submission s ON s.assignment=a.id AND s.userid=u.id\n AND s.attemptnumber=(SELECT MAX(s2.attemptnumber) FROM mdl_assign_submission s2\n WHERE s2.assignment=a.id AND s2.userid=u.id)\n LEFT JOIN mdl_grade_items gi ON gi.courseid=co.id AND gi.itemtype='mod'\n AND gi.itemmodule='assign' AND gi.iteminstance=a.id\n LEFT JOIN mdl_grade_grades gg ON gg.itemid=gi.id AND gg.userid=u.id\nWHERE co.id=:courseid AND co.visible=1 AND cm.visible=1 AND cm.deletioninprogress=0\n AND u.deleted=0 AND u.suspended=0 AND u.username<>'guest'\n AND a.duedate>0 AND a.duedate<UNIX_TIMESTAMP()\n AND (s.status IS NULL OR s.status<>'submitted' OR s.timemodified>a.duedate)\nORDER BY a.duedate,u.lastname,u.firstname",
