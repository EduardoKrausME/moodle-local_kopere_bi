          "theme": "light",
          "css": "",
          "html_before": null,
          "html_after": null,
          "commandsql": "SELECT e.id, e.userid, u.firstname, u.lastname, u.email, e.courseid, c.fullname AS course, e.timeenrolled, e.lastaccess, e.daysinactive, e.actions14, e.progress, e.gradepercent, e.riskscore,\n       CASE e.risklevel WHEN 'high' THEN 'lang::analytics_level_high::local_kopere_bi' ELSE 'lang::analytics_level_medium::local_kopere_bi' END AS risklevel,\n       CASE e.riskreason\n         WHEN 'noaccess' THEN 'lang::analytics_reason_noaccess::local_kopere_bi'\n         WHEN 'longinactive' THEN 'lang::analytics_reason_longinactive::local_kopere_bi'\n         WHEN 'lowgrade' THEN 'lang::analytics_reason_lowgrade::local_kopere_bi'\n         WHEN 'inactive' THEN 'lang::analytics_reason_inactive::local_kopere_bi'\n         WHEN 'lowactivity' THEN 'lang::analytics_reason_lowactivity::local_kopere_bi'\n         WHEN 'lowprogress' THEN 'lang::analytics_reason_lowprogress::local_kopere_bi'\n         ELSE 'lang::analytics_reason_monitor::local_kopere_bi'\n       END AS riskreason\nFROM mdl_local_kopere_bi_engage e\nJOIN mdl_user u ON u.id = e.userid\nJOIN mdl_course c ON c.id = e.courseid\nWHERE e.batchid = (SELECT MAX(batchid) FROM mdl_local_kopere_bi_engage)\n  AND e.risklevel IN ('high', 'medium')\n  AND e.timecompleted IS NULL\nORDER BY e.riskscore DESC, e.daysinactive DESC, c.fullname, u.lastname, u.firstname",
          "cache": "none",
          "reload": "none",
          "info": {
            "column": {
              "id": {"key": "id", "title": "#", "type": "number", "mustache": ""},
