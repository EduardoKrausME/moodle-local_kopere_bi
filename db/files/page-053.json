          "title": "lang::report_page_053_title::local_kopere_bi",
          "refkey": "kbi_el_course_gradebook_by_category",
          "block_num": 1,
          "type": "table",
          "theme": "light",
          "css": "",
          "html_before": "",
          "html_after": "",
          "commandsql": "SELECT DISTINCT CONCAT(u.id,'-',co.id,'-',COALESCE(gi.id,0)) AS id,\n u.id AS userid,u.firstname,u.lastname,u.idnumber,co.id AS courseid,co.fullname,\n gc.fullname AS category_name,gg.finalgrade,gi.grademax AS grade_max,\n CASE WHEN gi.grademax>gi.grademin AND gg.finalgrade IS NOT NULL\n THEN ROUND(100.0*(gg.finalgrade-gi.grademin)/NULLIF(gi.grademax-gi.grademin,0),2) END AS grade_percent,\n gg.timemodified AS grade_updated\nFROM mdl_course co JOIN mdl_context cx ON cx.contextlevel=50 AND cx.instanceid=co.id\n JOIN mdl_role_assignments ra ON ra.contextid=cx.id\n JOIN mdl_role r ON r.id=ra.roleid AND r.archetype='student'\n JOIN mdl_user u ON u.id=ra.userid\n LEFT JOIN mdl_grade_items gi ON gi.courseid=co.id AND gi.itemtype='category'\n LEFT JOIN mdl_grade_categories gc ON gc.id=gi.iteminstance\n LEFT JOIN mdl_grade_grades gg ON gg.itemid=gi.id AND gg.userid=u.id\nWHERE co.id>1 AND co.visible=1 AND u.deleted=0 AND u.suspended=0 AND u.username<>'guest'\nORDER BY co.fullname,u.lastname,u.firstname,gc.fullname",
          "cache": "1h",
          "reload": "none",
