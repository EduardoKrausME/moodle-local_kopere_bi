          "commandsql": "SELECT daykey, activeusers AS active_learners, actions AS learning_actions, logins\nFROM mdl_local_kopere_bi_daily\nWHERE batchid = (SELECT MAX(batchid) FROM mdl_local_kopere_bi_daily)\n  AND courseid = 0\nORDER BY daystart",
