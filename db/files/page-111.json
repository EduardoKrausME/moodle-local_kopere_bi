          "css": "",
          "html_before": null,
          "html_after": null,
          "commandsql": "SELECT e.id, e.userid, u.firstname, u.lastname, e.courseid, c.fullname AS course, e.lastaccess, e.actions7, e.previous7, ROUND(100.0 * (e.previous7 - e.actions7) / e.previous7, 2) AS declinepercent, e.progress, e.gradepercent, e.riskscore,\n       CASE e.risklevel WHEN 'high' THEN 'lang::analytics_level_high::local_kopere_bi' WHEN 'medium' THEN 'lang::analytics_level_medium::local_kopere_bi' WHEN 'low' THEN 'lang::analytics_level_low::local_kopere_bi' ELSE 'lang::analytics_level_none::local_kopere_bi' END AS risklevel\nFROM mdl_local_kopere_bi_engage e\nJOIN mdl_user u ON u.id = e.userid\nJOIN mdl_course c ON c.id = e.courseid\nWHERE e.batchid = (SELECT MAX(batchid) FROM mdl_local_kopere_bi_engage)\n  AND e.previous7 > 0\n  AND e.actions7 < e.previous7\n  AND e.timecompleted IS NULL\nORDER BY declinepercent DESC, e.riskscore DESC, c.fullname, u.lastname, u.firstname",
