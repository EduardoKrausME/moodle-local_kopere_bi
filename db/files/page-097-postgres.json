          "html_after": "",
          "commandsql": "SELECT CONCAT(m.id,'-',rec.id) AS id,m.id AS messageid,\n sender.id AS userid_from,sender.firstname AS firstname_from,sender.lastname AS lastname_from,\n sender.email AS email_from,rf.roles AS role_from,m.timecreated,\n rec.id AS userid_to,rec.firstname AS firstname_to,rec.lastname AS lastname_to,\n rec.email AS email_to,rt.roles AS role_to\nFROM mdl_messages m JOIN mdl_user sender ON sender.id=m.useridfrom\n JOIN mdl_message_conversation_members mc ON mc.conversationid=m.conversationid AND mc.userid<>m.useridfrom\n JOIN mdl_user rec ON rec.id=mc.userid\n LEFT JOIN (SELECT ra.userid,STRING_AGG(DISTINCT CAST(r.name AS TEXT), ', ') AS roles\n FROM mdl_role_assignments ra JOIN mdl_context cx ON cx.id=ra.contextid AND cx.contextlevel=10\n JOIN mdl_role r ON r.id=ra.roleid GROUP BY ra.userid) rf ON rf.userid=sender.id\n LEFT JOIN (SELECT ra.userid,STRING_AGG(DISTINCT CAST(r.name AS TEXT), ', ') AS roles\n FROM mdl_role_assignments ra JOIN mdl_context cx ON cx.id=ra.contextid AND cx.contextlevel=10\n JOIN mdl_role r ON r.id=ra.roleid GROUP BY ra.userid) rt ON rt.userid=rec.id\nWHERE m.timecreated>0 ORDER BY m.timecreated DESC,m.id DESC,rec.id",
